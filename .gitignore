# ── Build output ────────────────────────────────────────────
build/
build-*/
cmake-build-*/          # CLion
out/                    # Visual Studio "Open Folder"
bin/
lib/

# CMake leftovers (if someone configures in-source by mistake)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
Makefile
install_manifest.txt
compile_commands.json
_deps/                  # FetchContent downloads (GLFW, ImGui)

# Personal CMake presets (keep CMakePresets.json, ignore user overrides)
CMakeUserPresets.json

# ── Compiled objects & binaries ────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.app/

# ── IDEs & editors ──────────────────────────────────────────
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.user
*.suo
*.sln.docstates
.cache/                 # clangd index
.clangd/
*.swp
*~

# ── OS junk ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime files generated by Tessera ─────────────────────
# ImGui window/docking layout, rewritten on every exit
imgui.ini
*.log

# Shader / pipeline caches, captures, recordings
cache/
*.shadercache
*.rdc                   # RenderDoc captures
captures/
recordings/

# NOTE: third_party/glad/ is intentionally tracked (generated once, not fetched).
